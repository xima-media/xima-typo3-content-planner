includes:
	- %rootDir%/../../konradmichalik/phpstan-typo3-preset/phpstan.neon.dist
	- phpstan-baseline.neon

parameters:
	level: 6

	# Allow unmatched ignores: necessary because the lock-file determines which
	# TYPO3 major is installed when PHPStan runs, and some ignores only match
	# in v13 or v14 (e.g. deprecation notices, instanceof always-true/always-false).
	reportUnmatchedIgnoredErrors: false

	scanDirectories:
		- ../../vendor
		- ../../vendor/phpunit/phpunit/src
	paths:
		- ../../Classes
		- ../../Configuration
		- ../../Resources

	excludePaths:
		- ../../.Build (?)
		# TYPO3 v14 only - uses classes that don't exist in v13
		- ../../Classes/EventListener/AfterFileStorageTreeItemsPreparedListener.php
		- ../../Classes/Widgets/ConfigurableContentStatusWidget.php
		# konradmichalik/typo3-pagetree-facets is suggest-only - never installed for PHPStan
		- ../../Classes/Integration/PagetreeFacets/ContentPlannerFacet.php
		- ../../Classes/Integration/PagetreeFacets/RegisterContentPlannerFacetListener.php

	ignoreErrors:
		# getCssFiles()/getJavaScriptModuleInstructions() are genuinely overridden by
		# ConfigurableContentStatusWidget; final would break that override.
		-
			identifier: ergebnis.finalInAbstractClass
			path: ../../Classes/Widgets/AbstractWidget.php

	typo3:
		requestGetAttributeMapping:
			routing: 'TYPO3\CMS\Backend\Routing\RouteResult'
