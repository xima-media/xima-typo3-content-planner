includes:
	- %rootDir%/../../konradmichalik/phpstan-typo3-preset/phpstan.neon.dist
	- %rootDir%/../../phpstan/phpstan-phpunit/extension.neon
	- %rootDir%/../../phpstan/phpstan-phpunit/rules.neon

parameters:
	level: 6

	scanDirectories:
		- ../../vendor
		- ../../vendor/phpunit/phpunit/src
	paths:
		- ../../Classes
		- ../../Configuration
		- ../../Resources
		- ../../Tests/Unit
		- ../../Tests/Functional

	excludePaths:
		- ../../.Build (?)
		# konradmichalik/typo3-pagetree-facets is suggest-only - never installed for PHPStan
		- ../../Classes/Integration/PagetreeFacets/ContentPlannerFacet.php
		- ../../Classes/Integration/PagetreeFacets/RegisterContentPlannerFacetListener.php

	ignoreErrors:
		# TYPO3's itemsProcFunc contract calls these with $config by reference; the signature
		# is dictated by TYPO3 core (FormEngine), not by this extension.
		-
			identifier: ergebnis.noParameterPassedByReference
			path: ../../Classes/Utility/Data/StatusRegistry.php
		# TYPO3's DataHandler hook contract mandates these exact by-reference signatures
		# (processDatamap_preProcessFieldArray, processCmdmap_preProcess).
		-
			identifier: ergebnis.noParameterPassedByReference
			path: ../../Classes/Hooks/DataHandlerHook.php
		# getCssFiles()/getJavaScriptModuleInstructions() are genuinely overridden by
		# ConfigurableContentStatusWidget; final would break that override.
		-
			identifier: ergebnis.finalInAbstractClass
			path: ../../Classes/Widgets/AbstractWidget.php
		# $buttonProvider/$buttons/$options default to empty so Symfony DI service
		# definitions (Configuration/Services.yaml) can omit them when unused.
		-
			identifier: ergebnis.noConstructorParameterWithDefaultValue
			path: ../../Classes/Widgets/AbstractWidget.php
		# Named arguments keep fixtures readable, and abstract test cases are extended by design.
		-
			identifiers:
				- ergebnis.noNamedArgument
				- ergebnis.finalInAbstractClass
			path: ../../Tests/*

	type_coverage:
		constant: 0 # TODO: Set to 100, when PHP 8.3 is minimum requirement

	typo3:
		requestGetAttributeMapping:
			routing: 'TYPO3\CMS\Backend\Routing\RouteResult'
			route: 'TYPO3\CMS\Backend\Routing\Route'
